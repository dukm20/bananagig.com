# BananaGig local development environment. Copy to .env:  cp .env.example .env
# Default profile is core; add more with COMPOSE_PROFILES=core,observability,search,devtools
# ALL VALUES BELOW ARE DEVELOPMENT-ONLY PLACEHOLDERS. Never reuse them outside a laptop.

# --- APPLICATION ---
NODE_ENV=development
LOG_LEVEL=info

# --- DATABASE (PostgreSQL + PostGIS) ---
POSTGRES_DB=bananagig
POSTGRES_USER=bananagig
POSTGRES_PASSWORD=bananagig_dev_only
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://bananagig:bananagig_dev_only@postgres:5432/bananagig
# Used by `pnpm migrate` from the host (Postgres is published on 127.0.0.1 only)
DATABASE_URL_HOST=postgres://bananagig:bananagig_dev_only@127.0.0.1:5433/bananagig
KEYCLOAK_DB_PASSWORD=keycloak_dev_only

# --- VALKEY ---
VALKEY_URL=redis://valkey:6379

# --- KEYCLOAK ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_URL=http://keycloak:8080

# --- NATS ---
NATS_URL=nats://nats:4222

# --- S3 (SeaweedFS) ---
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=bananagig_dev_access
S3_SECRET_KEY=bananagig_dev_only_secret
S3_BUCKET=bananagig-dev
S3_REGION=us-east-1

# --- OPENSEARCH ---
OPENSEARCH_URL=http://opensearch:9200

# --- WEB -> API (server-side) ---
API_INTERNAL_URL=http://api:3000

# --- FEATURE FLAGS (flagd / OpenFeature) ---
FLAGD_HOST=flagd
FLAGD_PORT=8013

# --- OTEL ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_only

# --- EMAIL (Mailpit; nothing leaves the machine) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@bananagig.localhost

# --- PROXY (Caddy) ---
PROXY_HTTP_PORT=8080
COMPOSE_PROFILES=core
