# BananaGig local development environment. Copy to .env:  cp .env.example .env
# Default profile is core; add more with COMPOSE_PROFILES=core,observability,search,devtools
# ALL VALUES BELOW ARE DEVELOPMENT-ONLY PLACEHOLDERS. Never reuse them outside a laptop.

# --- APPLICATION ---
NODE_ENV=development
LOG_LEVEL=info

# --- DATABASE (PostgreSQL + PostGIS) ---
POSTGRES_DB=bananagig
POSTGRES_USER=bananagig
POSTGRES_PASSWORD=bananagig_dev_only
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://bananagig:bananagig_dev_only@postgres-db:5432/bananagig
# Used by `pnpm migrate` from the host (Postgres is published on 127.0.0.1 only)
DATABASE_URL_HOST=postgres://bananagig:bananagig_dev_only@127.0.0.1:5433/bananagig
KEYCLOAK_DB_PASSWORD=keycloak_dev_only

# Pool/timeout defaults per process role live in packages/database/src/policy.ts; set these only to override.
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500
# Log SQL text in slow-query warnings and spans. Keep false outside local development (SQL can contain sensitive literals).
DB_LOG_SQL=false
# Transactional outbox relay (worker)
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RETENTION_DAYS=7
# Configuration registry cache (Valkey): resolved values are cached up to this long; PostgreSQL stays authoritative
CONFIG_CACHE_TTL_SECONDS=30
CONFIG_LKG_MAX_AGE_SECONDS=86400
# Identity: an account's external identity last_seen_at is updated at most this often (seconds)
IDENTITY_LAST_SEEN_TOUCH_SECONDS=300
# Email verification (ID-002): HMAC key that hashes verification codes, magic-link tokens and abuse-limit dimensions (at least 32 characters).
# A DEVELOPMENT placeholder. Production sets its own random value and never commits it; the code length, validity and limits are product
# configuration (verification.email.* in the configuration registry), not environment variables.
VERIFICATION_HASH_SECRET=bananagig-dev-only-verification-hash-key-0001
# Phone verification (ID-003). DEV/TEST ONLY values: the fake SMS sink (Valkey) holds the plaintext code so tests and the smoke test can read it, and the fake
# classifier labels numbers deterministically. Production must use a real provider and sets SMS_TRANSPORT / PHONE_INTELLIGENCE explicitly (fake is refused there).
SMS_TRANSPORT=fake
PHONE_INTELLIGENCE=fake
# Provider verification evidence (TRUST-001). DEV/TEST ONLY: the fake scanner scans nothing (it flags only the harmless EICAR test string) and the fake external verification provider
# approves after a poll. Production sets TRUST_SCANNER / TRUST_EXTERNAL_PROVIDER explicitly (fake is refused there; disabled fails closed: no evidence can be attached until a real
# scanner exists). S3_PUBLIC_ENDPOINT is the address a caller OUTSIDE the container network reaches the private object store at (host of presigned URLs); default S3_ENDPOINT.
TRUST_SCANNER=fake
TRUST_EXTERNAL_PROVIDER=fake
# The exact number of reverse proxies in front of the API (Caddy locally). The API trusts that many X-Forwarded-For hops and no more (DEBT-0055).
TRUSTED_PROXY_HOPS=1

# --- VALKEY ---
VALKEY_URL=redis://valkey-cache:6379

# --- KEYCLOAK ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_URL=http://keycloak-auth:8080
# Browser-facing URL = token issuer. Keycloak pins `iss` to this value whichever host it is reached on.
KEYCLOAK_PUBLIC_URL=http://auth.localhost:8080
KEYCLOAK_REALM=bananagig
KEYCLOAK_API_AUDIENCE=bananagig-api
KEYCLOAK_WEB_CLIENT_ID=bananagig-web
KEYCLOAK_ADMIN_CLIENT_ID=bananagig-admin
# Account security (ID-004): the service-account client the API uses to ask Keycloak about a user's second factor and sessions, end sessions and send the
# reset-password email (admin REST API, client credentials). A DEVELOPMENT placeholder (at least 32 characters; it must equal the secret of the client in the
# realm). Production sets its own random value and never commits it; the placeholder is refused there.
KEYCLOAK_SECURITY_CLIENT_ID=bananagig-security
KEYCLOAK_SECURITY_CLIENT_SECRET=bananagig_security_dev_only_secret_0001
WEB_PUBLIC_URL=http://app.localhost:8080

# --- NATS ---
NATS_URL=nats://nats-events:4222

# --- S3 (SeaweedFS) ---
S3_ENDPOINT=http://seaweedfs-storage:8333
S3_ACCESS_KEY=bananagig_dev_access
S3_SECRET_KEY=bananagig_dev_only_secret
S3_BUCKET=bananagig-dev
S3_REGION=us-east-1

# --- OPENSEARCH ---
OPENSEARCH_URL=http://opensearch-search:9200

# --- WEB -> API (server-side) ---
API_INTERNAL_URL=http://api-service:3000

# --- FEATURE FLAGS (flagd / OpenFeature) ---
FLAGD_HOST=flagd-flags
FLAGD_PORT=8013

# --- OTEL ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_only

# --- EMAIL (Mailpit; nothing leaves the machine) ---
SMTP_HOST=mailpit-email
SMTP_PORT=1025
MAIL_FROM=no-reply@bananagig.localhost

# --- PROXY (Caddy) ---
PROXY_HTTP_PORT=8080
COMPOSE_PROFILES=core
