{
  "realm": "bananagig",
  "displayName": "BananaGig",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 900,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 1,
  "passwordPolicy": "length(12) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName",
    "totpAppFreeOTPName"
  ],
  "webAuthnPolicyRpEntityName": "BananaGig",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "smtpServer": {
    "host": "mailpit-email",
    "port": "1025",
    "from": "no-reply@bananagig.localhost",
    "fromDisplayName": "BananaGig",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "attributes": {
    "acr.loa.map": "{\"bananagig:password\": 1, \"bananagig:mfa\": 2}"
  },
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Identity role: account may act as a customer. Business permissions live in application data."
      },
      {
        "name": "provider",
        "description": "Identity role: account may act as a provider. Business permissions live in application data."
      }
    ],
    "client": {
      "bananagig-admin": [
        {
          "name": "admin-console-access",
          "description": "Allows signing in to the admin console client. Business admin permissions live in application data."
        },
        {
          "name": "configuration-read",
          "description": "TEMPORARY infrastructure permission: read the configuration registry (internal API). To be mapped to application permissions."
        },
        {
          "name": "configuration-write",
          "description": "TEMPORARY infrastructure permission: create parameters and change requests. To be mapped to application permissions."
        },
        {
          "name": "configuration-approve",
          "description": "TEMPORARY infrastructure permission: approve or reject configuration changes. To be mapped to application permissions."
        },
        {
          "name": "content-read",
          "description": "TEMPORARY infrastructure permission: read the content registry, resolve internal copy and preview with at= (internal API). To be mapped to application permissions."
        },
        {
          "name": "content-write",
          "description": "TEMPORARY infrastructure permission: create content entries, versions and locales, submit, cancel and publish. To be mapped to application permissions."
        },
        {
          "name": "content-approve",
          "description": "TEMPORARY infrastructure permission: approve or reject content versions. To be mapped to application permissions."
        },
        {
          "name": "content-legal",
          "description": "TEMPORARY infrastructure permission: additionally required to author, review and publish legal documents (entries owned by LEGAL). To be mapped to application permissions."
        },
        {
          "name": "geography-read",
          "description": "TEMPORARY infrastructure permission: read geography reference data with all statuses and management fields (internal API). To be mapped to application permissions."
        },
        {
          "name": "geography-write",
          "description": "TEMPORARY infrastructure permission: create and update countries and markets and activate or deactivate them. To be mapped to application permissions."
        }
      ]
    }
  },
  "scopeMappings": [
    {
      "client": "bananagig-web",
      "roles": [
        "customer",
        "provider"
      ]
    },
    {
      "client": "bananagig-dev-test",
      "roles": [
        "customer",
        "provider"
      ]
    }
  ],
  "clientScopeMappings": {
    "bananagig-admin": [
      {
        "client": "bananagig-admin",
        "roles": [
          "admin-console-access",
          "configuration-read",
          "configuration-write",
          "configuration-approve",
          "content-read",
          "content-write",
          "content-approve",
          "content-legal",
          "geography-read",
          "geography-write"
        ]
      }
    ],
    "realm-management": [
      {
        "client": "bananagig-security",
        "roles": [
          "manage-users"
        ]
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "sub and auth_time only",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm and client roles (identity roles only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "acr",
      "description": "Authentication context class reference (step-up)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "bananagig-api-audience",
      "description": "Adds the bananagig-api audience so the API accepts the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "bananagig-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bananagig-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a001",
      "alias": "bananagig-admin-browser",
      "description": "Admin console browser flow. DEV: OTP is required only once a user has a TOTP credential (conditional). PRODUCTION: built with OTP required and CONFIGURE_TOTP enforced (scripts/identity-realm.mjs --production).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "bananagig-admin-browser-forms"
        }
      ]
    },
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a002",
      "alias": "bananagig-admin-browser-forms",
      "description": "Username/password then OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "bananagig-admin-browser-otp"
        }
      ]
    },
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a003",
      "alias": "bananagig-admin-browser-otp",
      "description": "OTP (conditional in dev, required in production)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a010",
      "alias": "bananagig-browser",
      "description": "Customer/provider web browser flow: Cookie, else password then OTP (or recovery code) whenever the user has a second factor. Level of authentication: password = 1, MFA = 2. Bound to bananagig-web only.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "bananagig-browser-forms"
        }
      ]
    },
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a011",
      "alias": "bananagig-browser-forms",
      "description": "Username/password, then the second factor when the user has one",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "bananagig-browser-mfa"
        }
      ]
    },
    {
      "id": "b4a9c3e2-0000-4000-8000-00000000a012",
      "alias": "bananagig-browser-mfa",
      "description": "Second factor: applies only to users that have OTP or recovery codes and only below LoA 2 (client minimum.acr.value makes LoA 2 the floor)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "bananagig-web-loa2",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "bananagig-web-loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "2592000"
      }
    }
  ],
