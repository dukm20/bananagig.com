{
	auto_https off
	admin off
}

:80 {
	respond /caddy-health 200
	@app host app.localhost
	handle @app {
		# Same-origin access to the versioned API for browser code
		@appapi path /api/v1/*
		reverse_proxy @appapi api-service:3000
		reverse_proxy web-app:3000
	}

	@api host api.localhost
	handle @api {
		# Diagnostics are internal-only
		@internal path /internal/*
		respond @internal 404
		reverse_proxy api-service:3000
	}

	@auth host auth.localhost
	handle @auth {
		# Public identity host: ONLY the realm endpoints browsers need (login, tokens, logout, JWKS, discovery) and static resources.
		# The admin console, the master realm, health, metrics and every other path are not exposed here.
		@realm path /realms/bananagig /realms/bananagig/* /resources/*
		handle @realm {
			reverse_proxy keycloak-auth:8080
		}
		handle {
			respond "Not found" 404
		}
	}

	# DEV ONLY: Keycloak admin console on its own host name (KC_HOSTNAME_ADMIN). Remove this block in production
	# deployments and reach the admin console through a private network instead (DEBT-0004).
	@kcadmin host keycloak-admin.localhost
	handle @kcadmin {
		reverse_proxy keycloak-auth:8080
	}

	# Reserved for the future admin console application (separate host, separate Keycloak client bananagig-admin).
	@admin host admin.localhost
	handle @admin {
		respond "The BananaGig admin console is not implemented yet." 503
	}

	@grafana host grafana.localhost
	handle @grafana {
		reverse_proxy grafana-dashboard:3000
	}

	@mail host mail.localhost
	handle @mail {
		reverse_proxy mailpit-email:8025
	}

	@prom host prometheus.localhost
	handle @prom {
		reverse_proxy prometheus-metrics:9090
	}

	handle {
		respond "BananaGig local proxy: app|api|auth|grafana|mail|prometheus .localhost" 404
	}
}
