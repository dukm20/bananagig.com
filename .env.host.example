# Host-run development (pnpm dev): apps run on your machine, dependencies run in Docker with
# ports published on 127.0.0.1 by compose.dev.yaml. Copy to .env.host (git-ignored). Dev-only values.
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://bananagig:bananagig_dev_only@127.0.0.1:5433/bananagig
VALKEY_URL=redis://127.0.0.1:16379
NATS_URL=nats://127.0.0.1:14222
S3_ENDPOINT=http://127.0.0.1:18333
S3_ACCESS_KEY=bananagig_dev_access
S3_SECRET_KEY=bananagig_dev_only_secret
S3_BUCKET=bananagig-dev
OPENSEARCH_URL=http://127.0.0.1:19200
FLAGD_HOST=127.0.0.1
FLAGD_PORT=18013
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
KEYCLOAK_URL=http://127.0.0.1:18081
API_INTERNAL_URL=http://127.0.0.1:3211
WEB_DEV_PORT=3210
