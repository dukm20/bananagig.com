{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(.env)", "Read(.env.host)", "Edit(.env)", "Edit(.env.host)"],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(docker compose down -v *)",
      "Bash(pnpm stack:reset *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash.mjs", "timeout": 20, "onFailure": "block" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit.mjs", "timeout": 20, "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-bash.mjs", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.mjs", "timeout": 10 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-bash.mjs", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.mjs", "timeout": 10 }]
      }
    ]
  }
}
